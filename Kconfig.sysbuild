config REMOTE_BOARD
	string "The board target used for the FLPR image"
	default "nrf54lm20dk/nrf54lm20b/cpuflpr" if BOARD_NRF54LM20DK_NRF54LM20B_CPUAPP

config PARTITION_MANAGER
	default n

source "share/sysbuild/Kconfig"
