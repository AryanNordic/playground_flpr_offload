/*
 * FLPR side of the transport. The two shared-memory regions are the same
 * physical addresses as on the M33 with tx and rx swapped: this core writes
 * where the M33 reads and reads where the M33 writes.
 *
 * Nothing here depends on the peripheral. sysbuild.cmake adds
 * peripherals/<name>/peripheral.overlay to this image, the same overlay the M33
 * gets in the local baseline; only the owning core differs.
 */

/ {
	aliases {
		offload-marker = &led1;
	};

	soc {
		reserved-memory {
			#address-cells = <1>;
			#size-cells = <1>;

			sram_tx: memory@20066c00 {
				reg = <0x20066c00 0x800>;
			};

			sram_rx: memory@20067400 {
				reg = <0x20067400 0x800>;
			};
		};

		ipc {
			ipc0: ipc0 {
				compatible = "zephyr,ipc-icmsg";
				dcache-alignment = <32>;
				tx-region = <&sram_tx>;
				rx-region = <&sram_rx>;
				mboxes = <&cpuflpr_vevif_rx 21>, <&cpuflpr_vevif_tx 20>;
				mbox-names = "rx", "tx";
				status = "okay";
			};
		};
	};
};

&cpuflpr_vevif_rx {
	status = "okay";
};

&cpuflpr_vevif_tx {
	status = "okay";
};

&uart30 {
	/delete-property/ hw-flow-control;
};
